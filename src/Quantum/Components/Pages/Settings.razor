@namespace Quantum.Components.Pages
@page "/settings"
@implements IDisposable
@inject PluginCatalog PluginCatalog
@inject IPluginRuntimeManager PluginRuntimeManager
@inject CultureService CultureService
@inject IStringLocalizer<AppStrings> L
@inject NavigationManager Navigation
@using System.Text.Json
@using Quantum.Plugin.Abstraction

<PageTitle></PageTitle>

<div class="settings-page">
    <header class="settings-header">
        <img class="settings-logo" src="assets/quantum-mark.svg" alt="Quantum" />
        <div>
            <h1>@L["Settings"]</h1>
            <p>Quantum · @L["SettingsDescription"]</p>
        </div>
    </header>

    <nav class="settings-tabs" aria-label="@L["Settings"]">
        @foreach (var page in _pages)
        {
            var pageId = $"{page.PluginId}/{page.LocalId}";
            <button type="button" class="@(_activePage == pageId ? "active" : null)"
                    aria-pressed="@(_activePage == pageId)" @onclick="() => SelectPage(pageId)">
                @PageTitle(page)
            </button>
        }
    </nav>

    @if (_activePage == "quantum.settings/account")
    {
        <AccountSettings />
        <ExtensionOutlet PointId="quantum.settings/accounts" />
    }

    @if (_activePage == "quantum.settings/general")
    {
        <section class="section-block">
            <div class="section-heading">
                <div>
                    <h2>@L["LanguageAndRegion"]</h2>
                </div>
                <label class="language-picker">
                    <span>@L["DisplayLanguage"]</span>
                    <select value="@CultureService.CurrentCulture.Name" @onchange="ChangeCulture">
                        <option value="zh-CN">简体中文</option>
                        <option value="en-US">English</option>
                    </select>
                </label>
            </div>
        </section>

        <AppUpdatePanel />
        <ExtensionOutlet PointId="quantum.settings/general" />
    }

    @if (_activePage == "quantum.settings/plugins")
    {
        <section class="section-block">
            <div class="section-heading">
                <div>
                    <h2>@L["PluginRuntimeStatus"]</h2>
                </div>
                <button class="secondary-button"
                        disabled="@IsBusy"
                        @onclick="RefreshAsync">
                    @L["RefreshPlugins"]
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_operationMessage))
            {
                <div class="operation-message @(_operationSucceeded ? "success" : "error")" role="status">
                    @_operationMessage
                </div>
            }

            @if (PluginCatalog.Plugins.Count == 0)
            {
                <div class="empty-card">
                    <span class="empty-symbol">＋</span>
                    <div>
                        <strong>@L["NoInstalledPluginsFound"]</strong>
                        <p>@L["InstallAPluginZIPToGetStarted"]</p>
                    </div>
                </div>
            }
            else
            {
                <div class="plugin-list">
                    @foreach (var plugin in PluginCatalog.Plugins)
                    {
                        <article class="plugin-row">
                            <span class="plugin-avatar">@(((string)plugin.Manifest.Id)[0].ToString().ToUpperInvariant())</span>
                            <div class="plugin-meta">
                                <strong>@plugin.Manifest.Id</strong>
                                <span>@GetPluginVersionText(plugin)</span>
                            </div>
                            <span class="healthy-pill">@L["Running"]</span>
                            <div class="plugin-actions">
                                <button disabled="@IsBusy"
                                        @onclick="() => ReloadAsync((string)plugin.Manifest.Id)">
                                    @L["Reload"]
                                </button>
                                <button disabled="@IsBusy"
                                        @onclick="() => PrepareDisable((string)plugin.Manifest.Id)">
                                    @L["Disable"]
                                </button>
                                <button class="danger"
                                        disabled="@IsBusy"
                                        @onclick="() => PrepareUninstall((string)plugin.Manifest.Id)">
                                    @L["Uninstall"]
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        @if (_disabledPlugins.Count > 0)
        {
            <section class="section-block">
                <div class="section-heading">
                    <div>
                        <h2>@L["DisabledPlugins"]</h2>
                    </div>
                </div>

                <div class="plugin-list">
                    @foreach (var plugin in _disabledPlugins)
                    {
                        <article class="plugin-row">
                            <span class="plugin-avatar">@plugin.PluginId[0].ToString().ToUpperInvariant()</span>
                            <div class="plugin-meta">
                                <strong>@plugin.PluginId</strong>
                                <span>v@plugin.Version</span>
                            </div>
                            <span class="disabled-pill">@L["Disabled"]</span>
                            <div class="plugin-actions">
                                <button disabled="@IsBusy"
                                        @onclick="() => EnableAsync(plugin.PluginId)">
                                    @L["EnableAgain"]
                                </button>
                                <button class="danger"
                                        disabled="@IsBusy"
                                        @onclick="() => PrepareUninstall(plugin.PluginId)">
                                    @L["Uninstall"]
                                </button>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }

    @if (_activePage == "quantum.settings/plugins")
    {
        <ExtensionOutlet PointId="quantum.settings/plugins" />
    }
    else if (!_activePage.StartsWith("quantum.settings/", StringComparison.Ordinal))
    {
        <ExtensionOutlet @key="_activePage" PointId="quantum.settings/pages" ContributionId="@_activePage" />
    }

    @if (_pendingDisableImpact is { } disableImpact)
    {
        <div class="dialog-backdrop">
            <section class="unload-dialog disable-plugin-dialog"
                     role="alertdialog"
                     aria-modal="true"
                     aria-labelledby="disable-dialog-title">
                <p class="eyebrow">@L["DISABLEPLUGIN"]</p>
                <h2 id="disable-dialog-title">@L["DisableArg", disableImpact.PluginId]</h2>
                @if (disableImpact.DependentPluginIds.Count == 0)
                {
                    <p>@L["NoOtherPluginsWillBeAffected"]</p>
                }
                else
                {
                    <p>@L["ThesePluginsWillAlsoBeDisabled"]</p>
                    <ul>
                        @foreach (var dependentPluginId in disableImpact.DependentPluginIds)
                        {
                            <li>@dependentPluginId</li>
                        }
                    </ul>
                }
                <p class="dialog-note">@L["YouCanEnableThisPluginAgainLater"]</p>
                <div class="dialog-actions">
                    <button type="button" class="secondary-button" @onclick="CancelDisable">
                        @L["Cancel"]
                    </button>
                    <button type="button" class="primary-button" @onclick="ConfirmDisableAsync">
                        @L["ConfirmDisable"]
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_pendingUninstallImpact is { } uninstallImpact)
    {
        <div class="dialog-backdrop">
            <section class="unload-dialog"
                     role="alertdialog"
                     aria-modal="true"
                     aria-labelledby="uninstall-dialog-title">
                <p class="eyebrow">@L["UNINSTALLPLUGIN"]</p>
                <h2 id="uninstall-dialog-title">@L["PermanentlyUninstallArg", uninstallImpact.PluginId]</h2>
                @if (uninstallImpact.DependentPluginIds.Count == 0)
                {
                    <p>@L["NoOtherPluginsWillBeAffected"]</p>
                }
                else
                {
                    <p>@L["ThesePluginsWillAlsoBeUninstalled"]</p>
                    <ul>
                        @foreach (var dependentPluginId in uninstallImpact.DependentPluginIds)
                        {
                            <li>@dependentPluginId</li>
                        }
                    </ul>
                }
                <p class="dialog-note danger-note">@L["ThisPermanentlyRemovesThePluginAndItsFiles"]</p>
                <div class="dialog-actions">
                    <button type="button" class="secondary-button" @onclick="CancelUninstall">
                        @L["Cancel"]
                    </button>
                    <button type="button" class="danger-button" @onclick="ConfirmUninstallAsync">
                        @L["UninstallPermanently"]
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_activePage == "quantum.settings/plugins" && PluginCatalog.Failures.Count > 0)
    {
        <section class="section-block failures">
            <div class="section-heading">
                <div>
                    <h2>@L["PluginsNotLoaded"]</h2>
                </div>
            </div>
            @foreach (var failure in PluginCatalog.Failures)
            {
                <details class="failure-row">
                    <summary>
                        <strong>@(failure.PluginId?.ToString() ?? L["UnknownPlugin"].Value)</strong>
                        <span>@L["Details"]</span>
                    </summary>
                    <p>@failure.Reason</p>
                </details>
            }
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private string _activePage = "quantum.settings/general";
    private IReadOnlyList<QuantumExtensionContribution> _pages = [];
    private IDisposable? _pagesObservation;
    private bool _disposed;

    private string PageTitle(QuantumExtensionContribution page)
        => page.PluginId == "quantum.settings"
            ? L[page.Value.GetProperty("titleKey").GetString()!]
            : ExtensionOutlet.GetTitle(page.Value, page.LocalId, CultureService.CurrentCulture.Name);

    private void SelectPage(string pageId)
    {
        _activePage = pageId;
        var section = pageId.StartsWith("quantum.settings/", StringComparison.Ordinal)
            ? pageId["quantum.settings/".Length..] : pageId;
        Navigation.NavigateTo($"/settings?section={Uri.EscapeDataString(section)}", replace: true);
    }
    private string? _busyPluginId;
    private string? _operationMessage;
    private bool _operationSucceeded;
    private IReadOnlyList<DisabledPluginInfo> _disabledPlugins = [];
    private PluginOperationImpact? _pendingDisableImpact;
    private PluginOperationImpact? _pendingUninstallImpact;

    private bool IsBusy => _busyPluginId is not null
        || _pendingDisableImpact is not null
        || _pendingUninstallImpact is not null;

    private string GetPluginVersionText(LoadedPlugin plugin)
        => plugin.Routes.Count == 1
            ? L["PluginPageCountSingular", plugin.Manifest.Version, plugin.Routes.Count]
            : L["PluginPageCountPlural", plugin.Manifest.Version, plugin.Routes.Count];

    private void ChangeCulture(ChangeEventArgs eventArgs)
        => CultureService.SetCulture(eventArgs.Value?.ToString());

    protected override void OnParametersSet()
    {
        _activePage = Section switch
        {
            "account" => "quantum.settings/account",
            "plugins" => "quantum.settings/plugins",
            "general" => "quantum.settings/general",
            { } value when value.Contains('/') => value,
            _ => new Uri(Navigation.Uri).Fragment == "#account"
                ? "quantum.settings/account" : "quantum.settings/general"
        };
        if (_pages.Count > 0 && !_pages.Any(page => $"{page.PluginId}/{page.LocalId}" == _activePage))
        {
            _activePage = "quantum.settings/general";
        }
    }

    protected override void OnInitialized()
    {
        PluginCatalog.Changed += OnCatalogChanged;
        RefreshDisabledPlugins();
        _pagesObservation = PluginCatalog.Extensions.Observe("quantum.settings/pages", 1, snapshot =>
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }

                _pages = snapshot.Contributions.Where(page => page.Value.ValueKind == JsonValueKind.Object
                    && (page.PluginId == "quantum.settings" || ExtensionOutlet.IsValidView(page, PluginCatalog))).ToArray();
                if (!_pages.Any(page => $"{page.PluginId}/{page.LocalId}" == _activePage))
                {
                    _activePage = "quantum.settings/general";
                }

                StateHasChanged();
            });
        });
    }

    public void Dispose()
    {
        _disposed = true;
        _pagesObservation?.Dispose();
        PluginCatalog.Changed -= OnCatalogChanged;
    }

    private Task ReloadAsync(string pluginId)
        => RunOperationAsync(pluginId, () => PluginRuntimeManager.ReloadAsync(pluginId));

    private Task EnableAsync(string pluginId)
        => RunOperationAsync(pluginId, () => PluginRuntimeManager.EnableAsync(pluginId));

    private void PrepareDisable(string pluginId)
    {
        if (IsBusy)
        {
            return;
        }

        try
        {
            _pendingDisableImpact = PluginRuntimeManager.GetDisableImpact(pluginId);
            _operationMessage = null;
        }
        catch (Exception exception)
        {
            _operationSucceeded = false;
            _operationMessage = L["CouldNotPrepareDisableArg", exception.Message];
        }
    }

    private void CancelDisable()
        => _pendingDisableImpact = null;

    private async Task ConfirmDisableAsync()
    {
        var impact = _pendingDisableImpact;
        if (impact is null || _busyPluginId is not null)
        {
            return;
        }

        _pendingDisableImpact = null;
        await RunOperationAsync(
            impact.PluginId,
            () => PluginRuntimeManager.DisableAsync(impact.PluginId, impact.CatalogRevision));
    }

    private void PrepareUninstall(string pluginId)
    {
        if (IsBusy)
        {
            return;
        }

        try
        {
            _pendingUninstallImpact = PluginRuntimeManager.GetUninstallImpact(pluginId);
            _operationMessage = null;
        }
        catch (Exception exception)
        {
            _operationSucceeded = false;
            _operationMessage = L["CouldNotPrepareUninstallArg", exception.Message];
        }
    }

    private void CancelUninstall()
        => _pendingUninstallImpact = null;

    private async Task ConfirmUninstallAsync()
    {
        var impact = _pendingUninstallImpact;
        if (impact is null || _busyPluginId is not null)
        {
            return;
        }

        _pendingUninstallImpact = null;
        await RunOperationAsync(
            impact.PluginId,
            () => PluginRuntimeManager.UninstallAsync(impact.PluginId, impact.CatalogRevision));
    }

    private Task RefreshAsync()
        => RunOperationAsync("*", () => PluginRuntimeManager.RefreshAsync());

    private async Task RunOperationAsync(
        string operationId,
        Func<Task<PluginOperationResult>> operation)
    {
        if (IsBusy)
        {
            return;
        }

        _busyPluginId = operationId;
        _operationMessage = null;
        try
        {
            var result = await operation();
            _operationSucceeded = result.Succeeded;
            _operationMessage = result.Message;
        }
        catch (Exception exception)
        {
            _operationSucceeded = false;
            _operationMessage = L["PluginOperationFailedArg", exception.Message];
        }
        finally
        {
            _busyPluginId = null;
            RefreshDisabledPlugins();
        }
    }

    private void RefreshDisabledPlugins()
        => _disabledPlugins = PluginRuntimeManager.GetDisabledPlugins();

    private void OnCatalogChanged(object? sender, EventArgs eventArgs)
    {
        _ = InvokeAsync(() =>
        {
            RefreshDisabledPlugins();
            StateHasChanged();
        });
    }
}
