@namespace Quantum.ExampleDependentPlugin
@using Microsoft.Extensions.Localization
@using Quantum.ExampleDependentPlugin.Localization
@inject IStringLocalizer<PluginStrings> L

<p>@L["SettingsContributionDescription"]</p>
